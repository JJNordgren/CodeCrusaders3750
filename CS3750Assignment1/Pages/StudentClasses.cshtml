@page "{searchString?}"
@model CS3750Assignment1.Pages.StudentClassesModel
@{
    ViewData["Title"] = "Register Classes";
}

<div class="container mt-4">
    <!-- Title centered at the top -->
    <div class="text-center mb-4">
        <h1>Your Classes</h1>
    </div>

    <form>
        <p>
            
            <select asp-for="CourseDepartment" asp-items=" Model.Department">
                <option value="">All</option>
            </select>
            
            <label>Name: <input type="text" asp-for="SearchString" /></label>
            <input type="submit" value="Filter" />
        </p>
    </form>

    <!-- Table for listing classes -->
    @if (Model.Course != null && Model.Course.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Course[0].Department)</th>
                    <th>@Html.DisplayNameFor(model => model.Course[0].Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Course[0].ClassNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.Course[0].CreditHours)</th>
                    <th>@Html.DisplayNameFor(model => model.Course[0].Capacity)</th>
                    <th>Instructor</th>
                    <th>@Html.DisplayNameFor(model => model.Course[0].Location)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Course)
                {
                    <tr class="course-list">
                        <td>@Html.DisplayFor(modelItem => item.Department)</td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.ClassNumber)</td>
                        <td>@Html.DisplayFor(modelItem => item.CreditHours)</td>
                        <td>@Html.DisplayFor(modelItem => item.Capacity)</td>
                        <td>@($"{item.Instructor?.lastName}, {item.Instructor?.firstName}")</td>
                        <td>@Html.DisplayFor(modelItem => item.Location)</td>
                        <td class="course-buttons">
                            @if (Model.IsRegistered(item.Id))
                            {
                                <form method="post" asp-page-handler="Drop">
                                    <input type="hidden" name="courseId" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">Drop</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Register">
                                    <input type="hidden" name="courseId" value="@item.Id" />
                                    <button type="submit" class="btn btn-primary btn-sm">Register</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No courses available.</p>
    }
</div>






