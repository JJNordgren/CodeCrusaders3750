@page
@model CS3750Assignment1.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<body id="register">
    @* vh-100 *@
<div class="d-flex justify-content-center align-items-center m-3">
      @*   min-height: 45rem; *@
    <div class="card p-4" style="width: 25rem; ">
        <h1 class="text-center">Register</h1>
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div> <!--shows all errors at top of the page-->
            <div class="mb-3">
                <label for="firstName" class="form-label">First Name:</label>
                <input type="text" id="firstName" name="User.firstName" class="form-control" required />
                <span asp-validation-for="User.firstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label for="lastName" class="form-label">Last Name:</label>
                <input type="text" id="lastName" name="User.lastName" class="form-control" required />
                <span asp-validation-for="User.lastName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email Address:</label>
                <input type="email" id="email" name="User.email" class="form-control" required />
                <span asp-validation-for="User.email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password:</label>
                <input type="password" id="password" name="User.password" class="form-control" required />
                <span asp-validation-for="User.password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label for="confirmPassword" class="form-label">Confirm Password:</label>
                <input type="password" id="confirmPassword" name="User.confirmPassword" class="form-control" />
                <span asp-validation-for="User.confirmPassword" class="text-danger"></span>
                <span id="passwordError" class="text-danger"></span> <!-- For immediate feedback -->
            </div>
            <div class="mb-3">
                <label for="birthdate" class="form-label">Birth Date:</label>
                <input type="date" id="birthdate" name="User.BirthDate" class="form-control" required />
                <span asp-validation-for="User.BirthDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label d-block">Account Type:</label>
                <div class="form-check form-check-inline">
                    <input type="radio" id="student" name="User.userType" value="S" class="form-check-input" required />
                    <textarea hidden></textarea>
                    <label for="student" class="form-check-label">Student</label>
                </div>
                <div class="form-check form-check-inline">
                    <input type="radio" id="teacher" name="User.userType" value="T" class="form-check-input" required />
                    <textarea hidden>Not visible nor meant to be. It's here so that when you click the radio buttons this gets cleared instead of the label.</textarea>
                    <label for="teacher" class="form-check-label">Teacher</label>
                </div>
            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Create Account</button>
                <button type="submit" class="btn btn-secondary" onclick="window.location.href='/LoginPage'">Back to Login</button>
            </div>
        </form>
    </div>
</div>
</body>

<!-- logic to make sure passwords match immediately -->
<script>
    const passwordField = document.getElementById('password');
    const confirmPasswordField = document.getElementById('confirmPassword');
    const passwordError = document.getElementById('passwordError');

    function validatePasswords() {
        // Check if passwords match
        if (passwordField.value !== confirmPasswordField.value) {
            passwordError.textContent = 'Passwords do not match.';
        } else {
            passwordError.textContent = '';
        }
    }

    // Add event listeners for real-time validation
    passwordField.addEventListener('input', validatePasswords);
    confirmPasswordField.addEventListener('input', validatePasswords);

    // Function to clear error message when user starts typing
    function clearError(event) {
        event.target.nextElementSibling.textContent = ''; // Clears the next sibling span (error message)
    }

    // Select all input fields and attach event listeners
    document.querySelectorAll('input').forEach(input => {
        input.addEventListener('input', clearError);
    });


</script>