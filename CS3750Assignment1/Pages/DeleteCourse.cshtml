@page "{id:int}"
@model CS3750Assignment1.Pages.DeleteCourseModel

@{
    ViewData["Title"] = "Delete Course";
}

<div class="container mt-4">
    <h1 class="text-center text-danger mb-4">Delete Course</h1>

    <div class="card shadow-lg">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title mb-0">Are you sure you want to delete this course?</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Department:</dt>
                <dd class="col-sm-8">@Model.Course.Department</dd>

                <dt class="col-sm-4">Class Name:</dt>
                <dd class="col-sm-8">@Model.Course.Name</dd>

                <dt class="col-sm-4">Class Number:</dt>
                <dd class="col-sm-8">@Model.Course.ClassNumber</dd>

                <dt class="col-sm-4">Credit Hours:</dt>
                <dd class="col-sm-8">@Model.Course.CreditHours</dd>

                <dt class="col-sm-4">Location:</dt>
                <dd class="col-sm-8">@Model.Course.Location</dd>

                <dt class="col-sm-4">Meeting Days:</dt>
                <dd class="col-sm-8">@string.Join(", ", Model.Course.MeetingDays)</dd>

                <dt class="col-sm-4">Start Time:</dt>
                <dd class="col-sm-8">@Model.Course.StartTime</dd>

                <dt class="col-sm-4">End Time:</dt>
                <dd class="col-sm-8">@Model.Course.EndTime</dd>
            </dl>
        </div>

        <div class="card-footer text-center">
            <form method="post">
                <input type="hidden" asp-for="Course.Id" />
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-page="./InstructorClasses" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
