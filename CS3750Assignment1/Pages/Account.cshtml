@page
@model CS3750Assignment1.Pages.AccountModel
@{
}


<div class="row justify-content-center min-vh-100">
    <div class="col-md-11" style="padding: 20px; margin-bottom: 20px; max-width: 650px;">
        <form method="post">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="border-bottom-dark-blue">Payment</h1>
                <h3 class="text-end">Credits: @Model.Credits</h3>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="me-5">Remaining Balance: $@Model.Tuition</h3>
                <h3>Amount Paid: $@Model.totalAmountPaid</h3>
            </div>
            <div class="mb-3">
                <label for="amount" class="form-label">Amount to Pay:</label>
                <input type="text" id="amount" name="amount" class="form-control" required />
            </div>
           <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Pay</button>
                <button type="submit" class="btn btn-secondary" onclick="window.location.href='/Home'">Back to Home</button>
            </div>
        </form>
    </div>
</div>
