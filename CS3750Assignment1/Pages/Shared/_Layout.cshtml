﻿@using Newtonsoft.Json
@using static CS3750Assignment1.Models.User
@using static CS3750Assignment1.Models.Notification

<!DOCTYPE html>
<html lang="en">
<head>
    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CourseHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CS3750Assignment1.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <style>
        .form-popup {
            display: none;
            position: fixed;
            bottom: 0;
            right: 15px;
            border: 3px solid #f1f1f1;
            z-index: 9;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="bg-dark-blue text-light-green">

       
        @if (Context.Session.GetInt32("UserId") == null)
        {
            <div class="text-center py-3 bg-dark-blue text-light-green">
                <h1 class="m-0">CourseHub</h1>
            </div>
    
        }
        else
        {
            <nav class="navbar navbar-expand-sm bg-dark-blue border-0 box-shadow align-items-center">
                <div class="container d-flex justify-content-center align-items-center">
                    <a class="navbar-brand text-light-green" asp-area="" asp-page="/LoginPage">CourseHub</a>
                    <button class="navbar-toggler text-light-green" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-page="/Dashboard">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/Profile">Profile</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-page="/Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/Calendar">Calendar</a>
                            </li>
                            @if (Context.Session.GetString("UserType") == "T")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="" asp-page="/InstructorClasses">Classes</a>
                                </li>
                            }
                            @if (Context.Session.GetString("UserType") == "S")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="" asp-page="/StudentClasses">Register</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="" asp-page="/Account">Payments</a>
                                </li>
                            }
                        </ul>
                    </div>

                    @if (string.IsNullOrEmpty(@Context.Session.GetString("PicturePath")))
                    {
                        <div class="d-flex align-items-center">
                            <a asp-page="/ProfilePicture/Edit" asp-route-id="@Context.Session.GetInt32("UserId")">
                                <img src="/ProfileImages/bc10aade-00e1-4e39-acd8-eee7f423a4b9_user.png" alt="Default Profile Picture" style="width: 50px; height: 50px; border-radius: 50%;" />
                            </a>
                        </div>
                    }
                    else
                    {
                        var picturePath = Context.Session.GetString("PicturePath");
                        <div class="d-flex align-items-center">
                            <a asp-page="/ProfilePicture/Edit" asp-route-id="@Context.Session.GetInt32("UserId")">
                                <img src="@picturePath" alt="Profile Picture" style="width: 50px; height: 50px; border-radius: 50%;" />
                            </a>
                        </div>
                    }
                    <div class="d-flex align-items-center ms-3">
                        <i onclick="toggleNotificationForm()" id="notificationIcon" class="material-icons" style="width: 50px; height: 50px; cursor: pointer;">notifications</i>
                    </div>
                </div>
            </nav>
        }
    </header>

    <!-- Main content -->
    <div class="container flex-grow-1">
        <main role="main" class="pb-5 mb-5">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="mt-auto footer text-muted py-3 bg-dark-blue">
        <div class="container text-white">
            &copy; 2025 - CourseHub - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Notification popup -->
    <div class="form-popup" id="NotificationForm">
        <form class="form-container">
            <h1 class="text-center mb-4 mt-4">Notifications</h1>

            <div id="notifications">
                <div class="row">
                    <div class="col">
                        <div class="mx-auto card mb-3" style="max-width: 18rem;">
                            <a style="text-decoration: none;">
                               <div>

                               </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <script>
        function toggleNotificationForm() {
            var notificationForm = document.getElementById("NotificationForm");
            if (notificationForm.style.display === "block") {
                notificationForm.style.display = "none";
            } else {
                notificationForm.style.display = "block";
            }
        }

        function closeNotificationRow(button) {
            var row = button.closest('.row');
            row.style.display = 'none';
        }

        function addNotification(courseTitle, assignmentTitle, status) {
            // Get the notifications container
            const notificationsContainer = document.getElementById('notifications');

            // Create the row
            const row = document.createElement('div');
            row.className = 'row';

            // Create the column
            const col = document.createElement('div');
            col.className = 'col';

            // Create the card
            const card = document.createElement('div');
            card.className = 'mx-auto card mb-3';
            card.style.maxWidth = '18rem';

            // Create the anchor
            const anchor = document.createElement('a');
            anchor.style.textDecoration = 'none';

            // Create the card header
            const cardHeader = document.createElement('div');
            cardHeader.className = 'card-header';
            cardHeader.style.textDecoration = 'none';
            cardHeader.style.color = 'black';

            // Create the course title
            const h5 = document.createElement('h5');
            h5.className = 'card-title';
            h5.style.textDecoration = 'none';
            h5.textContent = courseTitle;

            // Create the assignment title
            const h6 = document.createElement('h6');
            h6.className = 'card-title';
            h6.style.textDecoration = 'none';
            h6.textContent = assignmentTitle;

            // Create the status
            const p = document.createElement('p');
            p.className = 'card-text';
            p.textContent = status;

            // Create the close button
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = 'Close';
            button.onclick = function () {
                closeNotificationRow(button);
            };

            // Assemble the card elements
            cardHeader.appendChild(h5);
            cardHeader.appendChild(h6);
            cardHeader.appendChild(p);
            cardHeader.appendChild(button);
            anchor.appendChild(cardHeader);
            card.appendChild(anchor);
            col.appendChild(card);
            row.appendChild(col);

            // Append the row to the notifications container
            notificationsContainer.appendChild(row);
        }
        addNotification("CourseName", "AssignmentName", "Message");

        // Loop through notifications and add only those for the current user
        Model.Notification.forEach(Notification => {
            if (Notification.userId === @Context.Session.GetInt32("UserId")) {
                addNotification(Notification.CourseName, Notification.AssignmentName, Notification.Message);
            }
        });
 


    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>