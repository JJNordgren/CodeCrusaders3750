@page
@model CS3750Assignment1.Pages.DashboardModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center mb-4">
    <h1>Dashboard</h1>  
</div>


 @foreach (var item in Model.Course) {
    <div class="card" style="width: 18rem;">
        <div class="card-body">
            <h5 class="card-title">@($"{item.Department} {item.ClassNumber}")</h5>
            <p class="card-text">@Html.DisplayFor(modelItem => item.Name)</p>
            <p class="card-text">@Html.DisplayFor(modelItem => item.Location)</p>
            <div>
                @string.Join(", ", item.MeetingDays)
            </div>
            <p class="card-text">@($"{item.StartTime} - {item.EndTime}")</p>
            <a href="#" class="btn btn-primary">Go somewhere</a>
        </div>
    </div>
}