@page
@model CS3750Assignment1.Pages.CancelModel
@{
}


<div class="row justify-content-center min-vh-100">
    <div class="col-md-8" style="padding: 20px; margin-bottom: 20px; max-width: 650px;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="border-bottom-dark-blue">Payment Cancelled</h1>
            <h3 class="text-end">Credits: @Model.Credits</h3>
        </div>

        <div class="d-flex align-items-center mb-3">
            <h3 class="me-5">Remaining Balance: $@Model.Tuition</h3>
        </div>

        <div class="d-flex align-items-center mb-3">
            <h3>Total Amount Paid: $@Model.totalAmountPaid</h3>

        </div>
        <div class="d-grid gap-2">
            <button type="button" class="btn btn-primary" onclick=" window.location.href='/Account'">Make a Payment</button>
            <button type="button" class="btn btn-secondary" onclick="window.location.href='/Dashboard'">Back to Dashboard</button>
        </div>
    </div>
</div>