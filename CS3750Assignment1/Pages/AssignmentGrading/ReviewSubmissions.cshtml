@page "{assignmentId:int}"
@model CS3750Assignment1.Pages.AssignmentGrading.ReviewSubmissionsModel
@{
    ViewData["Title"] = "Review Submissions";
}

<HeadContent>
    <script src="https://www.gstatic.com/charts/loader.js"></script>
    <script>
        google.charts.load('current', {packages: ['corechart']});
        google.charts.setOnLoadCallback(drawChart);
        
        function drawChart() {
            var data = google.visualization.arrayToDataTable([
                ['Grade', 'Number of Students'],
                ['A', @Model.NumStudentsPerGrade[0]],
                ['B', @Model.NumStudentsPerGrade[1]],
                ['C', @Model.NumStudentsPerGrade[2]],
                ['D', @Model.NumStudentsPerGrade[3]],
                ['E', @Model.NumStudentsPerGrade[4]]
            ]);

            var options = {
                height: 400,
                title: 'Class Grade Overview',
                colors: ['#28A745', '#9ACD32', '#EAB308', '#FF8C00', '#DC3545']
            };

            var chart = new google.visualization.PieChart(document.getElementById('piechart'));

            chart.draw(data, options);
        }
    </script>
</HeadContent>

<h1>Submissions for "@Model.AssignmentTitle"</h1>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Submission Date</th>
            <th>Submission Time</th>
            <th>Late</th>
            <th>Grade</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var submission in Model.Submissions)
{
    <tr>
        <td>@submission.Student.firstName</td>
        <td>@submission.Student.lastName</td>
        <td>@submission.SubmissionTime.ToShortDateString()</td>
        <td>@submission.SubmissionTime.ToShortTimeString()</td>
        <td>
            @* Check if the submission was after the due date *@
            @if (submission.SubmissionTime > Model.AssignmentDueDate)
            {
                <span class="text-danger">Late</span>
            }
        </td>
        <td>
            @if (submission.Grade.HasValue)
            {
                @submission.Grade
            }
        </td>
        <td>
            <a class="btn btn-primary btn-sm"
               asp-page="/AssignmentGrading/GradeAssignment"
               asp-route-submissionId="@submission.Id">
                Grade
            </a>
        </td>
    </tr>
}
    </tbody>
</table>

<div>
    @if ((@Model.NumStudentsPerGrade[0] == 0)
        && @Model.NumStudentsPerGrade[1] == 0
        && @Model.NumStudentsPerGrade[2] == 0
        && @Model.NumStudentsPerGrade[3] == 0
        && @Model.NumStudentsPerGrade[4] == 0) {
            <div></div>
    }
    else {
        <div id="piechart" style="width: 900px; height: 400px;"></div>
    }
</div>