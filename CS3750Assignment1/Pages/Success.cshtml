@page
@model CS3750Assignment1.Pages.SuccessModel
@{
}

<div class="row justify-content-center min-vh-100">
    <div class="col-md-8" style="padding: 20px; margin-bottom: 20px; max-width: 650px;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="border-bottom-dark-blue">Payment Success</h1>
            <h3 class="text-end">Credits: @Model.Credits</h3>
         </div>

        <div class="d-flex align-items-center mb-3">
            <h3>Remaining Balance: $@Model.Tuition</h3>
        </div>
        <div class="d-flex align-items-center mb-3">
            <h3>Amount Paid: $@Model.totalAmountPaid</h3>

        </div>
        <div class="mb-3">
			<h3>Payment Success: $@Model.amount</h3>
        </div>

        <div>
            <h1 class="border-bottom-dark-blue">Receipt</h1>
        </div>

        @if(Model.Tuition != 0){
            <div class="d-grid gap-2">
                <button type="button" class="btn btn-primary" onclick=" window.location.href='/Account'">Make a Payment</button>
                <button type="button" class="btn btn-secondary" onclick="window.location.href='/Home'">Back to Home</button>
            </div>
        } else{
            <div class="alert alert-success" role="alert">
                <h4 class="alert-heading">Congratulations!</h4>
                <p>Your payments are up to date.</p>
            </div>
            <div class="d-grid gap-2">
                <button type="button" class="btn btn-secondary" onclick="window.location.href='/Home'">Back to Home</button>
            </div>
        }
        
        <div class="m-3">
            <p>
                We appreciate your business! If you have any questions, please email
                <a href="mailto:codecrusaders3750@gmail.com">codecrusaders3750@gmail.com</a>.
            </p>
        </div>
    </div>
</div>