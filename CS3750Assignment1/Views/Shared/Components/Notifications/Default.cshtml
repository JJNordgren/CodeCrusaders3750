@model IEnumerable<CS3750Assignment1.Models.Notification>

<div id="notifications">
    @foreach (var notification in Model)
    {
        <div class="row" data-notification-id="@notification.Id">
            <div class="col">
                <div class="mx-auto card mb-3" style="max-width: 18rem;">
                    <a style="text-decoration: none;">
                        <div class="card-header" style="text-decoration: none; color: black;">
                            <h5 class="card-title" style="text-decoration: none;">@notification.CourseName</h5>
                            <h6 class="card-title" style="text-decoration: none;">@notification.AssignmentName</h6>
                            <p class="card-text">@notification.Message</p>
                            <button type="button" onclick="closeNotificationRow(this, @notification.Id)">Close</button>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
